{
  // Boldin's deployment of this app as a Cloudflare Worker, via OpenNext.
  // Build with `npm run cf:build`; CI deploys on push to main.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geo-aeo-tracker",
  "account_id": "aec67a3c3df77944f45b179d93c4223f",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: required by OpenNext; app code also uses node:crypto,
  // node:dns, node:net and Buffer.
  // global_fetch_strictly_public: server-side fetches to boldin.com hosts go
  // through Cloudflare's front door (Access, WAF) like any outside request,
  // instead of straight to the zone's origin. ssrf.ts can't catch that case,
  // because those hosts resolve to public Cloudflare IPs.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The custom domain is the only way in, and Cloudflare Access gates it:
  // app "Geo-Tracker (prod)", worker_apps in terraform-cloudflare-boldin
  // zone/config/prod.conf. The app has no login of its own, so a workers.dev
  // or preview URL would be an ungated door to the paid API keys.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "geo.prod.boldin.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    // Read at request time by siteOrigin() for page metadata, so it must be a
    // Worker var; setting it only at build has no effect.
    "NEXT_PUBLIC_SITE_URL": "https://geo.prod.boldin.com"
  }
  // Secrets (wrangler secret put <NAME>): BRIGHT_DATA_KEY, OPENROUTER_KEY,
  // GEMINI_API_KEY, plus SUPABASE_SERVICE_ROLE_KEY and STATE_SYNC_SECRET if
  // cloud sync is turned on. All optional; see .env.example.
}
